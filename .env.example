TELEGRAM_BOT_TOKEN=

DATABASE_URL=postgresql+asyncpg://mirea_rag:mirea_rag@localhost:5432/mirea_rag
# Решение принято: Qwen3-Embedding-0.6B, self-hosted через
# sentence-transformers (см. docs/embeddings-comparison.md). 1024 — макс.
# размерность этой модели (Matryoshka, можно обрезать при необходимости).
EMBEDDING_DIM=1024
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Решение принято: генерация ответа — через OpenRouter API (self-hosted
# LLM для чата почти всегда требует GPU, иначе задержка неприемлема).
# По умолчанию — бесплатная модель (лимит 20 запросов/мин), чтобы не
# тратить бюджет на внутреннем тестировании. Без ключа бот продолжает
# работать в режиме human-фолбека (см. bot.py).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
