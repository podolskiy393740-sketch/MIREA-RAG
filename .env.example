TELEGRAM_BOT_TOKEN=

DATABASE_URL=postgresql+asyncpg://mirea_rag:mirea_rag@localhost:5432/mirea_rag
# Решение принято: Qwen3-Embedding-0.6B, self-hosted через
# sentence-transformers (см. docs/embeddings-comparison.md). 1024 — макс.
# размерность этой модели (Matryoshka, можно обрезать при необходимости).
EMBEDDING_DIM=1024
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ФЗ-152 (требование куратора, CLAUDE.md): данные личного кабинета нельзя
# отправлять во внешний LLM API, даже без ФИО. На ПРОДЕ — только локальная
# модель на серверах вуза (LLM_MODE=local, значение по умолчанию). Внешние
# API (OpenAI/OpenRouter ниже) — СТРОГО временный режим прототипа:
# LLM_MODE=prototype включать только на разработке и в eval на публичных данных.
LLM_MODE=local
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=qwen3:8b

# [ТОЛЬКО ПРОТОТИП] Решение принято: генерация ответа — напрямую через OpenAI API (платный
# ключ команды). Без ключа бот продолжает работать в режиме
# human-фолбека (см. bot.py).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# OpenRouter — рабочая альтернатива (например, для сравнения на защите),
# сейчас никуда не подключена по умолчанию. Бесплатный тир нестабилен и
# ограничен жёсткой дневной квотой (50 запросов/день без пополнения).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
